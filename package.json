{
  "name": "stayup-api",
  "version": "3.4.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:functional": "vitest run tests/functional",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "create-user": "tsx scripts/create-user.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-admin:prod": "node dist/scripts/create-admin.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@scalar/hono-api-reference": "^0.12.19",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.18",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
